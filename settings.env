# ---- Non-secret settings (safe to commit) ----

# auto | serper | serpapi | mock   (auto = first source that has a key, else demo data)
PRODUCT_SOURCE=auto

# Search region and language, e.g. us, uk, pk, in, ae, ca
SEARCH_COUNTRY=us
SEARCH_LANGUAGE=en
CURRENCY_SYMBOL=$

# Groq models: small one for parsing, large one for the final verdict.
# (llama-3.1-8b-instant and llama-3.3-70b-versatile were retired by Groq in Aug 2026)
FAST_MODEL=openai/gpt-oss-20b
SMART_MODEL=openai/gpt-oss-120b

# true = run the LLM steps as CrewAI agents (needs `pip install crewai`), false = call Groq directly
USE_CREWAI=false

# Protect your free quota
MAX_SEARCHES_PER_SESSION=8
CACHE_TTL_SECONDS=3600
RESULTS_PER_SEARCH=12

# Tried in order if the model above is unavailable
FALLBACK_MODELS=openai/gpt-oss-120b,openai/gpt-oss-20b,qwen/qwen3.6-27b

# semantic = better knowledge-base search (downloads a ~70MB model once), keyword = no download
RAG_MODE=semantic
